# LLM Provider: "groq" (default) or "openai"
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (optional, used if LLM_PROVIDER=openai or as fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector Store Provider: "faiss" (default persistent local store) or "pinecone"
VECTOR_STORE_PROVIDER=faiss

# Pinecone Configuration (optional, used if VECTOR_STORE_PROVIDER=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=documind

# Search Configuration
ENABLE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.6

